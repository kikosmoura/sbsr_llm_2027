    "RankingInfo": {
      "additionalProperties": false,
      "properties": {
        "scope_uf": {
          "title": "Scope Uf",
          "type": "string"
        },
        "universe": {
          "const": "municipios_da_uf",
          "default": "municipios_da_uf",
          "title": "Universe",
          "type": "string"
        },
        "candidate_codes": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Codes",
          "type": "array"
        },
        "candidate_count": {
          "minimum": 1,
          "title": "Candidate Count",
          "type": "integer"
        },
        "verified_count": {
          "minimum": 1,
          "title": "Verified Count",
          "type": "integer"
        },
        "coverage": {
          "const": "completa",
          "default": "completa",
          "title": "Coverage",
          "type": "string"
