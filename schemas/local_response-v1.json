        },
        "nodata_area_ha": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nodata Area Ha"
        },
        "unknown_codes": {
          "items": {
            "type": "integer"
          },
          "title": "Unknown Codes",
