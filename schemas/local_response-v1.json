      "title": "ProcessingQuality",
      "type": "object"
    },
    "QueryAnswer": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "resposta-consulta-v1",
          "default": "resposta-consulta-v1",
