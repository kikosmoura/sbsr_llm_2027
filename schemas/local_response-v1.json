          "type": "integer"
        },
        "undefined_codes": {
          "items": {
            "type": "string"
          },
          "title": "Undefined Codes",
          "type": "array"
        },
        "qualifying_count": {
          "minimum": 0,
          "title": "Qualifying Count",
          "type": "integer"
        },
        "returned_count": {
          "minimum": 0,
          "title": "Returned Count",
          "type": "integer"
        }
