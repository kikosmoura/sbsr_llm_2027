        "class_codes": {
          "items": {
            "type": "integer"
          },
          "maxItems": 41,
          "minItems": 1,
          "title": "Class Codes",
          "type": "array"
        },
        "years": {
          "items": {
            "type": "integer"
          },
          "maxItems": 11,
          "minItems": 1,
          "title": "Years",
          "type": "array"
