          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ResponseStatus"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "answer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Id"
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
