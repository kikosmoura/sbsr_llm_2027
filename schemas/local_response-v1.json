      "required": [
        "operation",
        "metric",
        "unit",
        "class_codes",
        "years"
      ],
      "title": "QueryPlan",
      "type": "object"
    },
    "QueryValue": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
