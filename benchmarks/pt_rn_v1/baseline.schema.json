{
  "$defs": {
    "Metric": {
      "enum": [
        "area",
        "participacao",
        "diferenca_liquida",
        "reducao_liquida",
        "variacao_percentual",
        "diferenca_pontos_percentuais"
      ],
      "title": "Metric",
      "type": "string"
    },
    "NumericValue": {
      "additionalProperties": false,
      "properties": {
        "territory_code": {
          "pattern": "^(?:[0-9]{2}|[0-9]{7})$",
          "title": "Territory Code",
          "type": "string"
        },
        "years": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Years",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "undefined_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Undefined Reason"
        },
        "denominators_ha": {
          "items": {
            "type": "number"
          },
          "title": "Denominators Ha",
          "type": "array"
        },
        "rank": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        }
      },
      "required": [
        "territory_code",
        "years",
        "value",
        "unit"
      ],
      "title": "NumericValue",
      "type": "object"
    },
    "Operation": {
      "enum": [
        "area",
        "participacao",
        "comparacao_temporal",
        "serie_disponivel",
        "comparacao_territorial",
        "ranking_delimitado"
      ],
      "title": "Operation",
      "type": "string"
    },
    "QueryPlan": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "territory_codes": {
          "items": {
            "type": "string"
          },
          "title": "Territory Codes",
          "type": "array"
        },
        "scope_uf": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope Uf"
        },
        "class_codes": {
          "items": {
            "type": "integer"
          },
          "maxItems": 41,
          "minItems": 1,
          "title": "Class Codes",
          "type": "array"
        },
        "years": {
          "items": {
            "type": "integer"
          },
          "maxItems": 11,
          "minItems": 1,
          "title": "Years",
          "type": "array"
        },
        "denominator": {
          "anyOf": [
            {
              "enum": [
                "area_observada",
                "area_inicial",
                "participacao_por_ano"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "direction": {
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "title": "Direction",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        }
      },
      "required": [
        "operation",
        "metric",
        "unit",
        "class_codes",
        "years"
      ],
      "title": "QueryPlan",
      "type": "object"
    },
    "ResponseStatus": {
      "enum": [
        "respondida",
        "precisa_esclarecimento",
        "fora_do_escopo",
        "dados_indisponiveis",
        "erro_tecnico"
      ],
      "title": "ResponseStatus",
      "type": "string"
    },
    "Unit": {
      "enum": [
        "ha",
        "km2",
        "m2",
        "percentual",
        "pontos_percentuais"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "$ref": "#/$defs/ResponseStatus"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueryPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "values": {
      "items": {
        "$ref": "#/$defs/NumericValue"
      },
      "maxItems": 200,
      "title": "Values",
      "type": "array"
    },
    "clarification_field": {
      "anyOf": [
        {
          "enum": [
            "territorio",
            "classe",
            "metrica",
            "unidade",
            "periodo",
            "escopo",
            "limite",
            "ordenacao",
            "operacao"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarification Field"
    },
    "reason": {
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "status",
    "reason"
  ],
  "title": "BaselineAnswer",
  "type": "object"
}
